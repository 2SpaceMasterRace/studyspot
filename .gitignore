# Terraform
# .terraform.lock.hcl is deliberately NOT ignored: it pins provider checksums
# and belongs in version control, like uv.lock and bun.lock.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
terraform.tfvars
!terraform.tfvars.example

# Build artifacts
# `build/` above already covers infra/build/ and src/frontend/build/; these are
# named so that it is obvious they are generated.
infra/build/
src/backend/staticfiles/
