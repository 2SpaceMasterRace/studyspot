# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
#
#     cp terraform.tfvars.example terraform.tfvars

environment = "staging"
region      = "us-east-1"

# -- Keeping the Vercel deployment working -------------------------------------
#
# Retiring Turso leaves the Vercel functions with no database unless they can
# reach this one. Uncomment both values to give Postgres a public, TLS-only
# endpoint restricted to the networks you name.
#
# Find your Vercel plan's documented egress ranges before widening this. An
# allowlist of 0.0.0.0/0 exposes the database to the entire internet, protected
# only by the generated password.
#
# database_publicly_accessible = true
# database_allowed_cidrs       = ["203.0.113.0/24"]

# -- Production hardening ------------------------------------------------------
#
# environment              = "production"
# db_deletion_protection   = true
# db_skip_final_snapshot   = false
# db_multi_az              = true
# db_backup_retention_days = 14
# site_bucket_force_destroy = false
