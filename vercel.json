{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "src/frontend/",
      "buildCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"staging\" ]; then LC_ALL=C.UTF-8 LANG=C.UTF-8 uv run --project ../../docs sphinx-build --fail-on-warning --keep-going --builder html ../../docs/source static/docs; fi; bun run build"
    },
    "backend": {
      "root": "src/backend/",
      "entrypoint": "main:app",
      "framework": "fastapi",
      "rewrites": [
        {
          "source": "/api/:path*",
          "destination": "/:path*"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
